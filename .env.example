# ============================================================
# DARWIX VOICE INTELLIGENCE SUITE — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── ASR / Voice ──────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
# Public browser identifier only; never put a private Vapi credential in VITE_.
# VITE_VAPI_PUBLIC_KEY=
# Required for real Vapi calls: public HTTPS base URL for Veyra's grounded custom LLM and callbacks.
# Leave unset for the fully local browser-speech demo; Vapi cannot reach localhost.
# PUBLIC_WEBHOOK_URL=
# Vapi credential IDs, not secret values. Create both credentials in Vapi using
# the VOICE_SERVICE_TOKEN below: one Server Configuration bearer credential and
# one Custom LLM API-key credential.
# VAPI_SERVER_CREDENTIAL_ID=
# VAPI_CUSTOM_LLM_CREDENTIAL_ID=

# ── Express API Gateway ──────────────────────────────────────
PORT=3004
# SQLite database (default: data/veyra.sqlite). Requires Node >=22.13.
# VEYRA_DATABASE_PATH=C:/veyra-data/veyra.sqlite
# Legacy JSON archive directory, imported once without deleting originals.
# CALL_HISTORY_DIR=C:/veyra-data/calls
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Production requires a random session secret of at least 32 characters.
# AUTH_SESSION_SECRET=
# Required for the first workspace setup in production; remove after setup.
# WORKSPACE_SETUP_TOKEN=
# Required for Vapi callbacks; use a unique random value of at least 32 characters.
# The local browser-speech demo works without it.
# VOICE_SERVICE_TOKEN=
# Enable only behind one trusted HTTPS reverse proxy.
# TRUST_PROXY=1

# ── FastAPI Services ─────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8006
INGESTION_SERVICE_URL=http://localhost:8002
REALTIME_AI_URL=http://localhost:8003

# ── Knowledge Index ──────────────────────────────────────────
# FAISS directory used by RAG and ingestion. Keep separate per workspace/tenant.
FAISS_INDEX_PATH=./knowledge-base/embeddings/faiss_index

# ── Embeddings ───────────────────────────────────────────────
# Runtime services use Gemini's 3072-dimensional embedding model.
# This is documented here for operators; current code keeps the value fixed.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072

# ── Database ─────────────────────────────────────────────────
# Legacy utility setting. The gateway uses VEYRA_DATABASE_PATH above.
DATABASE_URL=sqlite:///./darwix.db

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
